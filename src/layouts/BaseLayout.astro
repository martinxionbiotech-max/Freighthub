---
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = 'Freighthub — China → GCC Freight Intelligence',
  description = 'China to GCC freight intelligence: routes, ports, customs, certification and live updates.',
  noindex = false,
} = Astro.props;
const SITE = Astro.site?.toString() ?? 'https://freighthub.net';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : `${SITE}${Astro.url.pathname}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/"><strong>Freighthub</strong> · China → GCC</a>
        <nav class="site-nav" aria-label="Main">
          <a href="/countries/">Countries</a>
          <a href="/ports/">Ports</a>
          <a href="/guides/">Guides</a>
          <a href="/sectors/">Sectors</a>
          <a href="/compare/">Compare</a>
          <a href="/updates/">Updates</a>
          <a href="/notes/">Notes</a>
          <a href="/about/">About</a>
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>Freighthub — China → GCC freight intelligence. Independent editorial analysis; no carrier or forwarder commissions.</p>
        <p><a href="/about/">About</a> · <a href="/methodology/">Methodology</a> · <a href="/corrections/">Corrections</a> · <a href="/contact/">Contact</a></p>
      </div>
    </footer>
  </body>
</html>
