---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Editorial pages pass article so the page emits Article JSON-LD. */
  type?: 'website' | 'article';
  published?: string;
  updated?: string;
  image?: string;
  jsonLd?: Record<string, unknown>[];
}

const {
  title = 'Freightgcc — China → GCC Freight Intelligence',
  description = 'China to GCC freight intelligence: routes, ports, customs, certification and live updates.',
  noindex = false,
  type = 'website',
  published,
  updated,
  image = '/og-default.png',
  jsonLd = [],
} = Astro.props;

const SITE = 'https://freightgcc.com';
const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImage = new URL(image, SITE).href;
const markdownAlternate = `${canonical.replace(/\/$/, '')}/index.md`;

const orgId = `${SITE}/#organization`;
const siteId = `${SITE}/#website`;
const personId = `${SITE}/author/wei-wong/#person`;

const organization = {
  '@type': 'Organization',
  '@id': orgId,
  name: 'Freightgcc',
  url: SITE,
  legalName: 'YIWU DINGWEI TRADING COMPANY',
  duns: '585974555',
  foundingDate: '2025-10',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '3# Building, North Silicon Valley',
    addressLocality: 'Qiaodong District, Zhangjiakou City',
    addressRegion: 'Hebei',
    addressCountry: 'CN',
  },
  description:
    'Independent editorial analysis of China-to-GCC freight: ports, routes, customs, certification and sector economics. No carrier or forwarder commissions.',
  email: 'inquiry@freightgcc.com',
  contactPoint: [
    { '@type': 'ContactPoint', contactType: 'sales', email: 'inquiry@freightgcc.com', telephone: '+86-13323237275', url: 'https://wa.me/8613323237275' },
    { '@type': 'ContactPoint', contactType: 'administrative', email: 'admin@freightgcc.com' },
    { '@type': 'ContactPoint', contactType: 'editorial', email: 'martin@freightgcc.com' },
  ],
  employee: { '@id': personId },
  knowsAbout: [
    'China to GCC ocean freight',
    'GCC customs and VAT',
    'SABER and SASO certification',
    'GCC port operations',
  ],
};

const person = {
  '@type': 'Person',
  '@id': personId,
  name: 'Wei Wong',
  url: `${SITE}/author/wei-wong/`,
  jobTitle: 'CEO, YIWU DINGWEI TRADING COMPANY; Author and Editorial Lead, Freightgcc',
  description:
    'Foreign trade and logistics professional with 20 years of experience; CEO of YIWU DINGWEI TRADING COMPANY and author/editorial lead at Freightgcc.',
  knowsAbout: ['International trade', 'Freight and logistics', 'China–GCC shipping'],
  worksFor: { '@id': orgId },
};

const website = {
  '@type': 'WebSite',
  '@id': siteId,
  name: 'Freightgcc',
  url: SITE,
  publisher: { '@id': orgId },
  inLanguage: 'en',
};

// Breadcrumbs are derived from the path: /guides/air-freight/ becomes
// Home > Guides > Air freight, with the last crumb unlinked.
const segments = Astro.url.pathname.split('/').filter(Boolean);
const humanize = (s: string) =>
  s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
const breadcrumbItems = [
  { name: 'Home', url: `${SITE}/` },
  ...segments.map((seg, i) => ({
    name: humanize(seg),
    url: `${SITE}/${segments.slice(0, i + 1).join('/')}/`,
  })),
];
const breadcrumbLd =
  segments.length > 0
    ? {
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbItems.map((b, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: b.name,
          item: b.url,
        })),
      }
    : null;

const articleLd =
  type === 'article'
    ? {
        '@type': 'Article',
        headline: title.replace(/ — Freightgcc$/, ''),
        description,
        ...(published ? { datePublished: published } : {}),
        ...(updated || published ? { dateModified: updated || published } : {}),
        author: { '@id': personId },
        publisher: { '@id': orgId },
        mainEntityOfPage: canonical,
        image: ogImage,
      }
    : null;

// Keep the Person node to article and author contexts. The Organization can
// still be useful on utility pages without resolving an employee reference.
const isPersonPage = type === 'article' || Astro.url.pathname === '/author/wei-wong/';
const organizationForPage = isPersonPage ? organization : { ...organization, employee: undefined };
const graph = [
  organizationForPage,
  website,
  ...(isPersonPage ? [person] : []),
  ...(breadcrumbLd ? [breadcrumbLd] : []),
  ...(articleLd ? [articleLd] : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b1f3a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {!noindex && <link rel="alternate" type="text/markdown" href={markdownAlternate} />}

    <meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
    <meta property="og:site_name" content="Freightgcc" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {type === 'article' && <meta name="author" content="Wei Wong" />}
    {type === 'article' && <meta property="article:author" content={`${SITE}/author/wei-wong/`} />}
    {type === 'article' && published && <meta property="article:published_time" content={published} />}
    {type === 'article' && updated && <meta property="article:modified_time" content={updated} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
    {jsonLd.map((entry) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({ '@context': 'https://schema.org', ...entry })}
      />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container">
        <a href="/" class="brand-link" aria-label="Freightgcc home">
          <img src="/logo.svg" alt="Freightgcc — China to GCC freight intelligence" class="brand-logo" width="280" height="50" />
        </a>
        <nav class="site-nav" aria-label="Main">
          <a href="/countries/">Countries</a>
          <a href="/ports/">Ports</a>
          <a href="/guides/">Guides</a>
          <a href="/tools/">Tools</a>
          <a href="/sectors/">Sectors</a>
          <a href="/compare/">Compare</a>
          <a href="/updates/">Updates</a>
          <a href="/notes/">Notes</a>
          <a href="/about/">About</a>
        </nav>
      </div>
    </header>
    <main class="container" id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>Freightgcc — China to GCC freight intelligence. Independent editorial analysis; no carrier or forwarder commissions.</p>
        <p class="footer-legal">
          Published by <strong>YIWU DINGWEI TRADING COMPANY</strong> · D-U-N-S 585974555 ·
          3# Building, North Silicon Valley, Qiaodong District, Zhangjiakou City, Hebei, China
        </p>
        <p class="footer-contact">
          <strong>Sales:</strong> <a href="mailto:inquiry@freightgcc.com">inquiry@freightgcc.com</a> ·
          <strong>Admin:</strong> <a href="mailto:admin@freightgcc.com">admin@freightgcc.com</a> ·
          <strong>Editor:</strong> <a href="mailto:martin@freightgcc.com">martin@freightgcc.com</a>
        </p>
        <p>
          <a class="btn-whatsapp" href="https://wa.me/8613323237275" target="_blank" rel="noopener">
            Contact us now
          </a>
          <span class="contact-note">WhatsApp: +86 133 2323 7275</span>
        </p>
        <p><a href="/about/">About</a> · <a href="/methodology/">Methodology</a> · <a href="/corrections/">Corrections</a> · <a href="/contact/">Contact</a></p>
        <p><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a> · <a href="/cookies/">Cookies</a> · <a href="/accessibility/">Accessibility</a> · <a href="/disclaimer/">Disclaimer</a></p>
      </div>
    </footer>
  </body>
</html>
