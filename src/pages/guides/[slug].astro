---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDoc } from '../../lib/content';
export function getStaticPaths() {
  const guides = [
  'china-to-saudi-arabia','china-to-uae','china-to-qatar','china-to-kuwait','china-to-oman','china-to-bahrain',
  'fcl','lcl','air-freight','ddp','customs-clearance','certification','cost-and-transit',
];
  return guides.map((slug) => ({ params: { slug } }));
}
const { slug } = Astro.params;
const doc = getDoc('guides', String(slug));
const label = String(slug).replace(/-/g, ' ');
---
<BaseLayout title={`${label} — Freighthub`} description={`China to GCC freight guide: ${label}.`} noindex={!doc}>
  <p><a href="/guides/">Guides</a> / {label}</p>
  {doc ? <div set:html={doc.html} /> : <><h1>{label}</h1><p>Draft scaffold — content production pending.</p></>}
</BaseLayout>
