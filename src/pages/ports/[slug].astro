---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { gccRegion } from '../../regions/gcc';
import { getDoc } from '../../lib/content';
export function getStaticPaths() {
  return gccRegion.ports.map((port) => ({ params: { slug: port.slug }, props: { port } }));
}
const { port } = Astro.props;
const country = gccRegion.countries.find((c) => c.slug === port.country);
const doc = getDoc('ports', port.slug);
---
<BaseLayout type="article" published={doc?.date || doc?.updated} updated={doc?.updated} title={doc?.seoTitle || (doc?.title ? `${doc.title} — Freightgcc` : `${port.name} — Freightgcc`)} description={doc?.description || `${port.name} port profile for China-origin freight.`} noindex={!doc}>
  <p><a href="/ports/">Ports</a> / {port.name}</p>
  <h1>{port.name}</h1>
  {doc ? (
    <>
      <p class="article-meta">By <a href="/author/wei-wong/">Wei Wong</a> · Last reviewed {doc.updated || '2026-11-04'}</p>
      <div set:html={doc.html} />
    </>
  ) : (
    <p>{country?.name} · port profile scaffold — content production pending.</p>
  )}
  <section class="related">
    <h2>Related pages</h2>
    <ul>
      {country && <li><a href={`/countries/${country.slug}/`}>China to {country.name}: customs, VAT and ports</a></li>}
      <li><a href="/guides/fcl/">FCL shipping to the GCC</a></li>
      <li><a href="/guides/customs-clearance/">Customs clearance</a></li>
      <li><a href="/compare/sea-vs-air/">Sea versus air</a></li>
    </ul>
  </section>
</BaseLayout>
