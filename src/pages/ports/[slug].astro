---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { gccRegion } from '../../regions/gcc';
import { getDoc } from '../../lib/content';
export function getStaticPaths() {
  return gccRegion.ports.map((port) => ({ params: { slug: port.slug }, props: { port } }));
}
const { port } = Astro.props;
const country = gccRegion.countries.find((c) => c.slug === port.country);
const doc = getDoc('ports', port.slug);
---
<BaseLayout title={doc?.seoTitle || (doc?.title ? `${doc.title} — Freighthub` : `${port.name} — Freighthub`)} description={doc?.description || `${port.name} port profile for China-origin freight.`} noindex={!doc}>
  <p><a href="/ports/">Ports</a> / {port.name}</p>
  <h1>{port.name}</h1>
  {doc ? (
    <>
      <p class="article-meta">By {doc.author || 'Freighthub editorial'} · Last reviewed {doc.updated || '2026-11-04'}</p>
      <div set:html={doc.html} />
    </>
  ) : (
    <p>{country?.name} · port profile scaffold — content production pending.</p>
  )}
</BaseLayout>
