---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { gccRegion } from '../../regions/gcc';
import { getDoc } from '../../lib/content';
export function getStaticPaths() {
  return gccRegion.countries.map((country) => ({ params: { slug: country.slug }, props: { country } }));
}
const { country } = Astro.props;
const doc = getDoc('countries', country.slug);
const pageTitle = doc?.title ? `${doc.title} — Freighthub` : `${country.name} — Freighthub`;
const pageDescription = doc?.description || `China to ${country.name} freight: ports, customs, VAT and route context.`;
---
<BaseLayout title={pageTitle} description={pageDescription} noindex={!doc}>
  <p><a href="/countries/">Countries</a> / {country.name}</p>
  <h1>{country.name}</h1>
  {doc ? (
    <>
      <p class="article-meta">By Freighthub editorial · Last reviewed {doc.updated || '2026-11-05'}</p>
      <div set:html={doc.html} />
    </>
  ) : (
    <p>China → {country.name} freight guide. Draft scaffold — content production pending.</p>
  )}
</BaseLayout>
