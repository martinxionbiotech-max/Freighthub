---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { gccRegion } from '../../regions/gcc';
import { getDoc } from '../../lib/content';
export function getStaticPaths() {
  return gccRegion.countries.map((country) => ({ params: { slug: country.slug }, props: { country } }));
}
const { country } = Astro.props;
const doc = getDoc('countries', country.slug);
const pageTitle = doc?.seoTitle || (doc?.title ? `${doc.title} — Freightgcc` : `${country.name} — Freightgcc`);
const pageDescription = doc?.description || `China to ${country.name} freight: ports, customs, VAT and route context.`;
---
<BaseLayout type="article" published={doc?.date || doc?.updated} updated={doc?.updated} title={pageTitle} description={pageDescription} noindex={!doc}>
  <p><a href="/countries/">Countries</a> / {country.name}</p>
  <h1>{country.name}</h1>
  {doc ? (
    <>
      <p class="article-meta">By <a href="/author/wei-wong/">Wei Wong</a> · Last reviewed {doc.updated || '2026-11-05'}</p>
      <div set:html={doc.html} />
    </>
  ) : (
    <p>China → {country.name} freight guide. Draft scaffold — content production pending.</p>
  )}
  <section class="related">
    <h2>Related pages</h2>
    <ul>
      {gccRegion.ports.filter((pt) => pt.country === country.slug).map((pt) => (
        <li><a href={`/ports/${pt.slug}/`}>{pt.name}</a></li>
      ))}
      <li><a href={`/guides/china-to-${country.slug}/`}>China to {country.name} freight guide</a></li>
      <li><a href="/guides/customs-clearance/">Customs clearance</a></li>
      <li><a href="/guides/certification/">Certification</a></li>
    </ul>
  </section>
</BaseLayout>
