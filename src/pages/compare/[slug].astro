---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDoc } from '../../lib/content';
export function getStaticPaths() {
  const comparisons = ['jebel-ali-vs-direct','jebel-ali-vs-khalifa','jeddah-vs-dammam','sea-vs-air','fcl-vs-lcl','ddp-vs-self-clearance','uae-vs-direct','uae-vs-saudi'];
  return comparisons.map((slug) => ({ params: { slug } }));
}
const { slug } = Astro.params;
const doc = getDoc('compare', String(slug));
const label = String(slug).replace(/-/g, ' ').replace(/ vs /g, ' vs ');
---
<BaseLayout title={`${label} — Freighthub`} description={`Freight decision: ${label}.`} noindex={!doc}>
  <p><a href="/compare/">Compare</a> / {label}</p>
  {doc ? <div set:html={doc.html} /> : <><h1>{label}</h1><p>Draft scaffold — content production pending.</p></>}
</BaseLayout>
