---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDoc } from '../../lib/content';
export function getStaticPaths() {
  const comparisons = ['jebel-ali-vs-direct','jebel-ali-vs-khalifa','jeddah-vs-dammam','sea-vs-air','fcl-vs-lcl','ddp-vs-self-clearance','uae-vs-direct','uae-vs-saudi'];
  return comparisons.map((slug) => ({ params: { slug } }));
}
const { slug } = Astro.params;
const doc = getDoc('compare', String(slug));
const label = String(slug).replace(/-/g, ' ').replace(/ vs /g, ' vs ');
const pageTitle = doc?.seoTitle || (doc?.title ? `${doc.title} — Freighthub` : `${label} — Freighthub`);
---
<BaseLayout title={pageTitle} description={doc?.description || `Freight decision: ${label}.`} noindex={!doc}>
  <p><a href="/compare/">Compare</a> / {label}</p>
  {doc ? (
    <article>
      <h1>{doc.title || label}</h1>
      <p class="article-meta">By {doc.author || 'Freighthub editorial'} · Last reviewed {doc.updated || '2026-11-11'}</p>
      <div set:html={doc.html} />
    </article>
  ) : (
    <><h1>{label}</h1><p>Draft scaffold — content production pending.</p></>
  )}
</BaseLayout>
