---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDoc } from '../../lib/content';
export function getStaticPaths() {
  const sectors = ['electronics','batteries','chemicals','food','furniture','machinery','ecommerce'];
  return sectors.map((slug) => ({ params: { slug } }));
}
const { slug } = Astro.params;
const doc = getDoc('sectors', String(slug));
const label = String(slug);
const pageTitle = doc?.seoTitle || (doc?.title ? `${doc.title} — Freighthub` : `${label} freight to GCC — Freighthub`);
---
<BaseLayout title={pageTitle} description={doc?.description || `China to GCC freight for ${label}.`} noindex={!doc}>
  <p><a href="/sectors/">Sectors</a> / {label}</p>
  {doc ? (
    <article>
      <h1>{doc.title || label}</h1>
      <p class="article-meta">By {doc.author || 'Freighthub editorial'} · Last reviewed {doc.updated || '2026-11-11'}</p>
      <div set:html={doc.html} />
    </article>
  ) : (
    <><h1>{label}</h1><p>Draft scaffold — content production pending.</p></>
  )}
</BaseLayout>
